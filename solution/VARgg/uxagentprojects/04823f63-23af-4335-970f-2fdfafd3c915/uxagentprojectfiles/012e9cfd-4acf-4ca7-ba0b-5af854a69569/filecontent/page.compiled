// --- Utility Functions ---
function getSemaforoColor(indice) {
    if (indice >= 60)
        return { color: "#FF3B3B", text: "Sospecha alta", textColor: "#FFFFFF" };
    if (indice > 0)
        return { color: "#FFB020", text: "Sospecha media", textColor: "#222222" };
    return { color: "#39FF14", text: "Limpio", textColor: "#222222" };
}
function pad2(n) {
    return n < 10 ? "0" + n : n;
}
function formatDateTime(date) {
    return "".concat(pad2(date.getHours()), ":").concat(pad2(date.getMinutes()), ":").concat(pad2(date.getSeconds()));
}
function calcularAntiguedad(fechaAlta) {
    if (!fechaAlta)
        return 0;
    var d = fechaAlta instanceof Date ? fechaAlta : new Date(fechaAlta);
    if (isNaN(d.getTime()))
        return 0;
    var diff = Date.now() - d.getTime();
    return Math.floor(diff / (1000 * 60 * 60 * 24));
}
